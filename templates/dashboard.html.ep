% layout 'default';
% title 'Орбита МКС — положение и погода';
<main class="dashboard" id="main">
  <header class="page-heading">
    <p class="eyebrow">МКС / Земля</p>
    <h1>Погода под МКС</h1>
    <p class="intro">Где сейчас проходит Международная космическая станция и какая погода в точке под ней.</p>
  </header>
  <div class="overview">
    %= include 'snapshot', latest => $latest
  </div>
  <section id="history" class="history" aria-labelledby="history-title">
    <p class="eyebrow">Журнал наблюдений</p>
    <h2 id="history-title">История пролётов</h2>
    % if (!@$observations) {
      <p class="empty-note history-empty">Наблюдения появятся после первого пролёта.</p>
    % }
    <ol class="history-list">
      % for my $observation (@$observations) {
        %= include 'history_row', observation => $observation
      % }
    </ol>
  </section>
</main>
