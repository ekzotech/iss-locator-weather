<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Координаты Международной космической станции и погода под ней">
    <title><%= title %></title>
    %= stylesheet '/tracker.css'
    <script src="<%= url_for '/tracker.js' %>" defer></script>
  </head>
  <body>
    <header class="masthead">
      <a class="wordmark" href="<%= url_for 'dashboard' %>">Орбита МКС</a>
      <span class="masthead-note">Положение и погода</span>
    </header>
    <%= content %>
    <footer class="site-footer">
      <span>Орбита МКС</span>
      <span class="site-sources">
        <a href="https://github.com/open-notify/Open-Notify-API">Open Notify</a> ·
        <a href="https://open-meteo.com/">Open-Meteo</a> ·
        <a href="https://www.naturalearthdata.com/">Natural Earth</a>
      </span>
    </footer>
  </body>
</html>
