<figure class="panel map-panel" aria-labelledby="map-title">
  <figcaption class="map-caption">
    <p class="eyebrow">Траектория</p>
    <h2 id="map-title">Карта пролёта</h2>
  </figcaption>
  <div class="map-frame">
    <svg class="world-map" viewBox="0 0 <%= $map_width %> <%= $map_height %>"
      role="img" aria-labelledby="map-svg-title">
      <title id="map-svg-title">Карта мира с береговой линией</title>
      <path class="map-grid" d="M120 0V360M240 0V360M360 0V360M480 0V360M600 0V360M0 60H720M0 120H720M0 180H720M0 240H720M0 300H720"/>
      <path class="map-land" fill-rule="evenodd" d="<%= $land_path %>"/>
    </svg>
  </div>
</figure>
